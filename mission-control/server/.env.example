# Copy to .env in this directory. run.sh loads it at server startup.
BULLSEYE_MODE=simulation

# Optional: actual MJPEG/JPEG-over-HTTP stream URL from your working camera.
# Example from vendor source only; verify the physical camera's URL first.
# CAMERA_STREAM_URL=http://192.168.4.1:81/stream

# Exercise collection failure/retry once per server lifetime (simulation only).
BULLSEYE_SIM_FAIL_COLLECTION_ONCE=0

# run-rover-demo.sh sets hardware mode and enables the separate /bench page.
# With the bench enabled, an unset CAMERA_STREAM_URL defaults to the vendor URL.
# Keep real missions/continuous drive disabled; this is a wheels-raised step demo.
BULLSEYE_BENCH_ENABLED=0
# ROVER_HOST=192.168.4.1
# ROVER_PORT=100
