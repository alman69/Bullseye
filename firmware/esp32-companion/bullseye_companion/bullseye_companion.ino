// ===== esp32-companion/CompanionHttp.h =====

#include <stdint.h>
#include <stddef.h>
#include <string.h>
#include <stdio.h>
#include <ctype.h>
#include <limits.h>

namespace companion {
enum class Command : uint8_t { Invalid, Status, Squeeze, Release, Home, Stop, Relax };
inline const char* commandName(Command command) {
  switch (command) {
    case Command::Status: return "status";
    case Command::Squeeze: return "squeeze";
    case Command::Release: return "release";
    case Command::Home: return "home";
    case Command::Stop: return "stop";
    case Command::Relax: return "relax";
    default: return "invalid";
  }
}
inline Command commandFrom(const char* name) {
  for (uint8_t i = 1; i <= 6; ++i) if (!strcmp(name, commandName(static_cast<Command>(i)))) return static_cast<Command>(i);
  return Command::Invalid;
}
inline bool unsigned32(const char* text, uint32_t& value) {
  if (!text || !*text) return false;
  uint32_t result = 0;
  for (const char* c = text; *c; ++c) {
    if (*c < '0' || *c > '9') return false;
    const uint32_t digit = *c - '0';
    if (result > (UINT32_MAX - digit) / 10) return false;
    result = result * 10 + digit;
  }
  value = result; return true;
}
inline bool equalsIgnoreCase(const char* first, const char* second) {
  while (*first && *second) {
    if (tolower(static_cast<unsigned char>(*first++)) != tolower(static_cast<unsigned char>(*second++))) return false;
  }
  return *first == *second;
}

struct Request {
  Command command = Command::Invalid;
  uint32_t boot = 0, sequence = 0;
  int error = 400;
};

// Small fixed-endpoint HTTP/1.x decoder. No body, chunked transfer, keep-alive,
// dynamic allocation, blocking reads or unbounded request processing.
class HttpDecoder {
 public:
  static constexpr size_t capacity = 1536;
  static constexpr uint32_t timeoutMs = 500;
  void reset(uint32_t now) { length_ = 0; ready_ = false; error_ = 0; started_ = now; }
  bool expired(uint32_t now) const { return static_cast<uint32_t>(now - started_) >= timeoutMs; }
  bool ready() const { return ready_; }
  void feed(const uint8_t* data, size_t count) {
    for (size_t i = 0; i < count && !ready_; ++i) {
      const uint8_t c = data[i];
      if ((c < 32 && c != '\r' && c != '\n' && c != '\t') || c > 126) { error_ = 400; ready_ = true; break; }
      if (length_ == capacity - 1) { error_ = 431; ready_ = true; break; }
      text_[length_++] = static_cast<char>(c);
      text_[length_] = '\0';
      if (length_ >= 4 && !memcmp(text_ + length_ - 4, "\r\n\r\n", 4)) ready_ = true;
    }
  }
  Request decode() {
    Request result;
    if (!ready_) return result;
    if (error_) { result.error = error_; return result; }
    char* end = strstr(text_, "\r\n");
    if (!end || end - text_ > 224) return result;
    *end = '\0';
    char method[8], path[192], version[16], extra;
    if (sscanf(text_, "%7s %191s %15s %c", method, path, version, &extra) != 3 ||
        (strcmp(version, "HTTP/1.1") && strcmp(version, "HTTP/1.0"))) return result;
    bool contentLengthSeen = false;
    for (char* header = end + 2; *header;) {
      char* next = strstr(header, "\r\n");
      if (!next) return result;
      if (next == header) break;
      *next = '\0';
      char* colon = strchr(header, ':');
      if (!colon || colon == header || *header == ' ' || *header == '\t') return result;
      *colon = '\0';
      char* value = colon + 1;
      while (*value == ' ' || *value == '\t') ++value;
      char* tail = value + strlen(value);
      while (tail > value && (tail[-1] == ' ' || tail[-1] == '\t')) *--tail = '\0';
      if (equalsIgnoreCase(header, "Transfer-Encoding")) return result;
      if (equalsIgnoreCase(header, "Content-Length")) {
        uint32_t length = 0;
        if (contentLengthSeen || !unsigned32(value, length)) return result;
        contentLengthSeen = true;
        if (length != 0) { result.error = 413; return result; }
      }
      header = next + 2;
    }
    if (!strcmp(path, "/status")) {
      if (strcmp(method, "GET")) { result.error = 405; return result; }
      result.command = Command::Status; result.error = 0; return result;
    }
    constexpr const char* prefix = "/command?";
    if (strncmp(path, prefix, strlen(prefix))) { result.error = 404; return result; }
    if (strcmp(method, "POST")) { result.error = 405; return result; }
    unsigned fields = 0;
    for (char* pair = path + strlen(prefix); pair && *pair;) {
      char* next = strchr(pair, '&'); if (next) *next++ = '\0';
      char* equal = strchr(pair, '='); if (!equal) return result;
      *equal++ = '\0';
      unsigned field;
      if (!strcmp(pair, "name")) { field = 1; result.command = commandFrom(equal); }
      else if (!strcmp(pair, "boot")) { field = 2; if (!unsigned32(equal, result.boot)) return result; }
      else if (!strcmp(pair, "seq")) { field = 4; if (!unsigned32(equal, result.sequence)) return result; }
      else return result;
      if (fields & field) return result;
      fields |= field; pair = next;
    }
    if (result.command == Command::Invalid || result.command == Command::Status) return result;
    if (fields != 7 || !result.boot || !result.sequence) { result.error = 409; return result; }
    result.error = 0; return result;
  }
 private:
  char text_[capacity] = {};
  size_t length_ = 0;
  uint32_t started_ = 0;
  bool ready_ = false;
  int error_ = 0;
};

// A newer STOP invalidates older packets even if Wi-Fi delivers them late.
class CommandOrder {
 public:
  explicit CommandOrder(uint32_t boot = 1) : boot_(boot ? boot : 1) {}
  void begin(uint32_t boot) { boot_ = boot ? boot : 1; sequence_ = 0; }
  bool accept(uint32_t boot, uint32_t sequence) {
    if (boot != boot_ || sequence == 0 || sequence <= sequence_) return false;
    sequence_ = sequence; return true;
  }
  void fence() { if (sequence_ < UINT32_MAX) ++sequence_; }
  uint32_t boot() const { return boot_; }
  uint32_t sequence() const { return sequence_; }
 private:
  uint32_t boot_, sequence_ = 0;
};
}  // namespace companion


// ===== esp32-companion/CompanionControl.h =====



namespace companion {
// Shared by the actual sketch and native integration checks. Only this main-loop
// controller changes servo targets; BLE telemetry never enters this interface.
template <class Out> class Control {
 public:
  explicit Control(Out& out) : arm_(out) {}
  bool begin(uint32_t now, uint32_t boot) {
    order_.begin(boot); servoReady_ = arm_.begin(now); return servoReady_;
  }
  void outputReady(bool ready) { servoReady_ &= ready; if (!servoReady_) arm_.relax(); }
  const scooper::Scooper<Out>& arm() const { return arm_; }
  const CommandOrder& order() const { return order_; }
  bool servoReady() const { return servoReady_; }
  bool watchdogStopped() const { return watchdogStopped_; }
  const char* execute(const Request& request, uint32_t now) {
    if (request.error) return "unsupported request";
    if (request.command == Command::Status) { lastContact_ = now; return nullptr; }
    if (!order_.accept(request.boot, request.sequence)) return "old command or board restarted; reconnect";
    lastContact_ = now;
    return run(request.command, now, true);
  }
  const char* local(Command command, uint32_t now) { return run(command, now, false); }
  bool setJoint(uint8_t joint, int degrees, uint16_t speed) {
    if (!servoReady_ || !arm_.setJoint(joint, degrees, speed)) return false;
    order_.fence(); wirelessMotion_ = false; return true;
  }
  void tick(uint32_t now, bool wifi) {
    if (wifiWasConnected_ && !wifi && wirelessMotion_) stopWireless();
    wifiWasConnected_ = wifi;
    const bool moving = arm_.state() == scooper::State::Moving || arm_.state() == scooper::State::Sequence;
    if (wirelessMotion_ && moving && static_cast<uint32_t>(now - lastContact_) >= 2000) stopWireless();
    arm_.update(now);
  }
 private:
  void stopWireless() { arm_.stop(); order_.fence(); wirelessMotion_ = false; watchdogStopped_ = true; }
  const char* run(Command command, uint32_t now, bool wireless) {
    if (command == Command::Stop || command == Command::Relax) {
      if (command == Command::Stop) arm_.stop(); else arm_.relax();
      wirelessMotion_ = false;
      if (!wireless) order_.fence();
      return nullptr;
    }
    if (!servoReady_) return "servo PWM initialization failed; inspect pins and restart";
    bool ok = false;
    if (command == Command::Squeeze) ok = arm_.squeeze();
    else if (command == Command::Release) ok = arm_.release();
    else if (command == Command::Home) ok = arm_.home();
    else return "unknown command";
    if (!ok) return arm_.error();
    wirelessMotion_ = wireless; watchdogStopped_ = false; lastContact_ = now;
    return nullptr;
  }
  scooper::Scooper<Out> arm_;
  CommandOrder order_;
  uint32_t lastContact_ = 0;
  bool servoReady_ = false, wirelessMotion_ = false, watchdogStopped_ = false, wifiWasConnected_ = false;
};
}  // namespace companion


// ===== esp32-companion/CompanionRuntime.h =====

#include <Arduino.h>
#include <WiFi.h>
#include <NetworkServer.h>
#include <NetworkClient.h>
#include <esp_random.h>
#include <lwip/sockets.h>
#include <errno.h>





namespace companion {
class Runtime {
 public:
  Runtime() : control_(servos_), listener_(scooper::kHttpPort) {}
  void begin() {
    bool output = control_.begin(millis(), esp_random());
    for (uint8_t i = 0; i < scooper::kJointCount; ++i) output &= ledcReadFreq(scooper::kJoints[i].pin) > 0;
    control_.outputReady(output);
    if (!output) Serial.println("Scooper PWM failed; motion disabled until restart.");
    WiFi.mode(WIFI_STA);
    WiFi.setSleep(false);
    WiFi.setAutoReconnect(true);
    if (!WiFi.config(ip(scooper::kScooperIp), ip(scooper::kGatewayIp), ip(scooper::kSubnetMask))) {
      Serial.println("Scooper fixed-IP configuration failed; inspect Wi-Fi before use.");
    }
    joinWifi();
    Serial.println("Combined display + scooper ready. Serial: status, wifi, stop, relax, home, squeeze, release, set 1|2 degrees [speed].");
    printStatus();
  }
  void poll(uint32_t now) {
    readSerial(now);
    const bool wifi = WiFi.status() == WL_CONNECTED;
    wifiConnected_ = wifi;
    if (wifi && !listening_) {
      listener_.begin(); listening_ = true;
      Serial.printf("Companion Wi-Fi: http://%s\n", WiFi.localIP().toString().c_str());
    } else if (!wifi && listening_) {
      closeClient(); listener_.end(); listening_ = false;
    }
    if (!wifi && static_cast<uint32_t>(now - lastWifiAttempt_) >= scooper::kWifiRetryMs) joinWifi();
    if (wifi) serve(now);
    control_.tick(millis(), wifi);
  }
  // Called around longer screen operations as well as on every loop iteration.
  void updateMotion(uint32_t now) { control_.tick(now, wifiConnected_); }
 private:
  static IPAddress ip(const uint8_t (&parts)[4]) { return IPAddress(parts[0], parts[1], parts[2], parts[3]); }
  void joinWifi() {
    lastWifiAttempt_ = millis();
    WiFi.disconnect();
    WiFi.begin(scooper::kWifiSsid, scooper::kWifiPassword[0] ? scooper::kWifiPassword : nullptr);
  }
  void statusJson(char* out, size_t capacity) const {
    const auto& arm = control_.arm();
    const bool sequence = arm.state() == scooper::State::Sequence;
    char labels[80];
    if (sequence) snprintf(labels, sizeof(labels), "\"%s\",\"step\":\"%s\"", arm.sequenceName(), arm.stepLabel());
    else snprintf(labels, sizeof(labels), "null,\"step\":null");
    snprintf(out, capacity,
      "{\"firmware\":\"bullseye-companion\",\"api\":2,\"boot_id\":%lu,\"command_seq\":%lu,\"servo_ready\":%s,\"watchdog_stopped\":%s,\"state\":\"%s\",\"sequence\":%s,\"angles\":{\"left\":%d,\"right\":%d}}",
      static_cast<unsigned long>(control_.order().boot()), static_cast<unsigned long>(control_.order().sequence()), control_.servoReady() ? "true" : "false",
      control_.watchdogStopped() ? "true" : "false", scooper::stateName(arm.state()), labels, arm.angle(0), arm.angle(1));
  }
  void respond(int code, const char* error = nullptr, bool commandReply = false) {
    char status[384], body[512]; statusJson(status, sizeof(status));
    if (error) snprintf(body, sizeof(body), "{\"ok\":false,\"error\":\"%s\",\"status\":%s}", error, status);
    else if (commandReply) snprintf(body, sizeof(body), "{\"ok\":true,\"status\":%s}", status);
    else snprintf(body, sizeof(body), "%s", status);
    const char* reason = code == 200 ? "OK" : code == 409 ? "Conflict" : code == 404 ? "Not Found" :
                         code == 405 ? "Method Not Allowed" : code == 413 ? "Payload Too Large" : code == 431 ? "Request Header Fields Too Large" : "Bad Request";
    const int length = snprintf(response_, sizeof(response_),
      "HTTP/1.1 %d %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\nContent-Length: %u\r\n\r\n%s",
      code, reason, static_cast<unsigned>(strlen(body)), body);
    if (length < 0 || static_cast<size_t>(length) >= sizeof(response_)) { closeClient(); return; }
    responseLength_ = static_cast<size_t>(length); sent_ = 0;
  }
  void serve(uint32_t now) {
    if (!active_) {
      client_ = listener_.accept();
      if (!client_) return;
      active_ = true; decoder_.reset(now); responseLength_ = sent_ = 0;
    }
    if (!client_.connected() || decoder_.expired(now)) { closeClient(); return; }
    if (!responseLength_) {
      const int available = client_.available();
      if (available > 0) {
        uint8_t bytes[256];
        const int count = client_.read(bytes, available > 256 ? 256 : available);
        if (count > 0) decoder_.feed(bytes, static_cast<size_t>(count));
      }
      if (!decoder_.ready()) return;
      const Request request = decoder_.decode();
      if (request.error) respond(request.error, request.error == 409 ? "update Mission Control; boot and seq are required" : "unsupported HTTP request");
      else {
        const char* error = control_.execute(request, now);
        respond(error ? 409 : 200, error, request.command != Command::Status);
      }
    }
    if (responseLength_) {
      const size_t remaining = responseLength_ - sent_;
      // NetworkClient::write retries on slow peers. One nonblocking send instead
      // keeps BLE framing, touch, servo slew and face animation running.
      const int count = ::send(client_.fd(), response_ + sent_, remaining > 384 ? 384 : remaining, MSG_DONTWAIT);
      if (count > 0) sent_ += static_cast<size_t>(count);
      else if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK) { closeClient(); return; }
      if (sent_ == responseLength_) closeClient();
    }
  }
  void closeClient() { client_.stop(); active_ = false; responseLength_ = sent_ = 0; }
  void printStatus() const { char status[384]; statusJson(status, sizeof(status)); Serial.println(status); }
  void serialCommand() {
    line_[lineLength_] = '\0';
    char* name = strtok(line_, " \t"); if (!name) return;
    if (!strcmp(name, "status")) { printStatus(); return; }
    if (!strcmp(name, "wifi")) { Serial.printf("Wi-Fi: %s / %s\n", WiFi.status() == WL_CONNECTED ? "connected" : "disconnected", WiFi.localIP().toString().c_str()); return; }
    if (!strcmp(name, "x")) name = const_cast<char*>("stop");
    if (!strcmp(name, "set")) {
      uint32_t joint = 0, degrees = 0, speed = scooper::kDefaultDegPerSec;
      const char* speedText;
      if (!unsigned32(strtok(nullptr, " \t"), joint) || !unsigned32(strtok(nullptr, " \t"), degrees) ||
          ((speedText = strtok(nullptr, " \t")) && !unsigned32(speedText, speed)) || strtok(nullptr, " \t") ||
          joint < 1 || joint > 2 || degrees > 180 || speed < 1 || speed > 600 || !control_.servoReady()) { Serial.println("error: set 1|2 degrees [speed 1-600]"); return; }
      if (!control_.setJoint(joint - 1, static_cast<int>(degrees), speed)) Serial.printf("error: %s\n", control_.arm().error());
      else Serial.println("ok");
      return;
    }
    if (strtok(nullptr, " \t")) { Serial.println("error: unexpected arguments"); return; }
    const char* error = control_.local(commandFrom(name), millis());
    if (error) Serial.printf("error: %s\n", error); else { Serial.println("ok"); printStatus(); }
  }
  void readSerial(uint32_t now) {
    if (lineLength_ && static_cast<uint32_t>(now - lineStarted_) >= 2000) { lineLength_ = 0; lineOverflow_ = true; }
    for (int budget = 128; budget > 0 && Serial.available(); --budget) {
      const char c = static_cast<char>(Serial.read());
      if (c == '\r' || c == '\n') {
        if (lineOverflow_) Serial.println("error: oversized, invalid or expired serial line");
        else if (lineLength_) serialCommand();
        lineLength_ = 0; lineOverflow_ = false;
      } else if (c < 32 || c > 126 || lineLength_ == sizeof(line_) - 1) lineOverflow_ = true;
      else if (!lineOverflow_) { if (!lineLength_) lineStarted_ = now; line_[lineLength_++] = c; }
    }
  }
  scooper::LedcServos servos_;
  Control<scooper::LedcServos> control_;
  NetworkServer listener_;
  NetworkClient client_;
  HttpDecoder decoder_;
  char response_[768] = {}, line_[64] = {};
  size_t responseLength_ = 0, sent_ = 0, lineLength_ = 0;
  uint32_t lastWifiAttempt_ = 0, lineStarted_ = 0;
  bool active_ = false, listening_ = false, wifiConnected_ = false, lineOverflow_ = false;
};
}  // namespace companion


// ===== Shared Arduino setup and loop =====
// Display/BLE runtime, sharing the loop with the independent scooper controller.
#include <Arduino.h>
#include <SPI.h>
#include <Wire.h>
#include <DFRobot_GDL.h>
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLE2902.h>
#if defined(CONFIG_NIMBLE_ENABLED)
#include <host/ble_hs_mbuf.h>
#endif



companion::Runtime companionController;

DFRobot_ST7365P_320x480_HW_SPI screen(8, 10, 9, GDL_PIN_NC);
bullseye::Receiver receiver;
bullseye::Model model;
bullseye::Renderer renderer;
SemaphoreHandle_t stateMutex;
BLEServer* server = nullptr;
BLECharacteristic* ackCharacteristic = nullptr;
BLE2902* ackSubscription = nullptr;
bool connected = false, advertisePending = false;
int32_t activeConnection = -1;
uint32_t epoch = 0, disconnectedAt = 0;

// Exact-length, bounded touch access copied from the working Onebox adapter.
class TouchBus {
 public:
  bool read(uint8_t address, uint16_t reg, uint8_t regBytes, uint8_t* out, size_t count) {
    Wire.beginTransmission(address);
    if (regBytes == 2) Wire.write(static_cast<uint8_t>(reg >> 8));
    Wire.write(static_cast<uint8_t>(reg));
    if (Wire.endTransmission(false) != 0) return false;
    if (Wire.requestFrom(address, count, true) != count) {
      while (Wire.available()) Wire.read();
      return false;
    }
    for (size_t i = 0; i < count; ++i) out[i] = static_cast<uint8_t>(Wire.read());
    return true;
  }
  bool write(uint8_t address, uint16_t reg, uint8_t value) {
    Wire.beginTransmission(address);
    Wire.write(static_cast<uint8_t>(reg >> 8));
    Wire.write(static_cast<uint8_t>(reg));
    Wire.write(value);
    return Wire.endTransmission(true) == 0;
  }
};
TouchBus touchBus;
onebox::TouchController<TouchBus> touchController(touchBus);
onebox::TouchGestures gestures;
bool touchBusStarted = false, touchReady = false;
uint32_t lastTouch = 0, lastTouchAttempt = 0, lastRender = 0;

void beginTouch() {
  pinMode(6, OUTPUT); digitalWrite(6, LOW);
  pinMode(7, OUTPUT); digitalWrite(7, LOW);
  delay(10); digitalWrite(6, HIGH); delay(5);
  delay(50); pinMode(7, INPUT); delay(100);
  Wire.setTimeOut(5);
  touchBusStarted = Wire.begin(4, 5, 100000);
  touchReady = touchBusStarted && touchController.begin();
  lastTouchAttempt = millis();
  Serial.printf("Touch: %s\n", touchController.name());
}

class ServerCallbacks : public BLEServerCallbacks {
  void accept(BLEServer* owner, uint16_t id) {
    xSemaphoreTake(stateMutex, portMAX_DELAY);
    const bool reject = connected;
    if (!reject) {
      connected = true; activeConnection = id;
      ++epoch; receiver.reset(); advertisePending = false;
    }
    xSemaphoreGive(stateMutex);
    if (reject) owner->disconnect(id);
  }
  void dropped(uint16_t id) {
    xSemaphoreTake(stateMutex, portMAX_DELAY);
    if (activeConnection == id) {
      connected = false; activeConnection = -1; ++epoch; receiver.reset();
      advertisePending = true; disconnectedAt = millis();
    }
    xSemaphoreGive(stateMutex);
  }
#if defined(CONFIG_NIMBLE_ENABLED)
  void onConnect(BLEServer* owner, ble_gap_conn_desc* desc) override { accept(owner, desc->conn_handle); }
  void onDisconnect(BLEServer*, ble_gap_conn_desc* desc) override { dropped(desc->conn_handle); }
#else
  void onConnect(BLEServer* owner, esp_ble_gatts_cb_param_t* param) override { accept(owner, param->connect.conn_id); }
  void onDisconnect(BLEServer*, esp_ble_gatts_cb_param_t* param) override { dropped(param->disconnect.conn_id); }
#endif
};

class DataCallbacks : public BLECharacteristicCallbacks {
  void ingest(BLECharacteristic* characteristic, uint16_t id) {
    // getValue is bounded by the GATT attribute limit, and also works for the
    // core's execute-write callback. No JSON or display access in this callback.
    const String data = characteristic->getValue();
    xSemaphoreTake(stateMutex, portMAX_DELAY);
    if (connected && activeConnection == id) {
      if (data.length() > 512) receiver.reject();
      else receiver.feed(reinterpret_cast<const uint8_t*>(data.c_str()), data.length(), millis(), epoch);
    }
    xSemaphoreGive(stateMutex);
  }
#if defined(CONFIG_NIMBLE_ENABLED)
  void onWrite(BLECharacteristic* characteristic, ble_gap_conn_desc* desc) override { ingest(characteristic, desc->conn_handle); }
#else
  void onWrite(BLECharacteristic* characteristic, esp_ble_gatts_cb_param_t* param) override { ingest(characteristic, param->write.conn_id); }
#endif
};

// State mutex held: bind the notification to the accepted connection, rather
// than broadcasting an old frame's ACK to a newly connected central.
void sendAckLocked(bullseye::Ack status, uint32_t sequence) {
  uint8_t bytes[8]; bullseye::encodeAck(bytes, status, sequence);
  ackCharacteristic->setValue(bytes, sizeof(bytes));
  if (connected && activeConnection >= 0) {
#if defined(CONFIG_NIMBLE_ENABLED)
    os_mbuf* buffer = ble_hs_mbuf_from_flat(bytes, sizeof(bytes));
    if (buffer) ble_gatts_notify_custom(static_cast<uint16_t>(activeConnection), ackCharacteristic->getHandle(), buffer);
#else
    if (!ackSubscription->getNotifications()) return;
    esp_ble_gatts_send_indicate(server->getGattsIf(), static_cast<uint16_t>(activeConnection),
                               ackCharacteristic->getHandle(), sizeof(bytes), bytes, false);
#endif
  }
}

void beginBle() {
  BLEDevice::init("Bullseye-Display");
  BLEDevice::setMTU(185);  // Preference only; sender uses the actual negotiated MTU.
  server = BLEDevice::createServer();
  server->setCallbacks(new ServerCallbacks());
  BLEService* service = server->createService(bullseye::kServiceUuid);
  ackCharacteristic = service->createCharacteristic(bullseye::kAckUuid,
      BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_NOTIFY);
#if defined(CONFIG_BLUEDROID_ENABLED)
  ackSubscription = new BLE2902();
  ackCharacteristic->addDescriptor(ackSubscription);
#endif
  uint8_t initial[8]; bullseye::encodeAck(initial, bullseye::Ack::Invalid, 0);
  ackCharacteristic->setValue(initial, sizeof(initial));
  BLECharacteristic* rx = service->createCharacteristic(bullseye::kRxUuid, BLECharacteristic::PROPERTY_WRITE);
  rx->setCallbacks(new DataCallbacks());
  service->start();
  BLEAdvertisementData advertised, response;
  advertised.setFlags(0x06);
  advertised.setCompleteServices(BLEUUID(bullseye::kServiceUuid));
  response.setName("Bullseye-Display");
  BLEAdvertising* advertising = server->getAdvertising();
  advertising->setAdvertisementData(advertised);
  advertising->setScanResponseData(response);
  advertising->setScanResponse(true);
  advertising->start();
  Serial.println("Bullseye BLE display ready; waiting for Mac sender.");
}

void setup() {
  Serial.begin(115200);
  stateMutex = xSemaphoreCreateMutex();
  if (!stateMutex) { Serial.println("Unable to allocate display mailbox mutex"); while (true) delay(1000); }
  SPI.begin(12, 13, 11, 10);
  screen.begin(8000000);
  screen.setRotation(3);
  beginTouch();
  renderer.render(screen, model, touchReady ? touchController.name() : "unavailable", millis());
  beginBle();
  companionController.begin();
}

void loop() {
  companionController.poll(millis());
  uint32_t now = millis();
  bool advertise = false;
  xSemaphoreTake(stateMutex, portMAX_DELAY);
  receiver.expire(now);
  model.link(connected, epoch, now);
  const uint8_t error = receiver.takeError();
  if (error) { ++model.errors; if (connected) sendAckLocked(static_cast<bullseye::Ack>(error), 0); }
  if (advertisePending && !connected && static_cast<uint32_t>(now - disconnectedAt) >= 100) {
    advertise = true; advertisePending = false;
  }
  xSemaphoreGive(stateMutex);
  if (advertise) server->startAdvertising();

  for (uint8_t i = 0; i < 2; ++i) {
    bullseye::Frame frame;
    xSemaphoreTake(stateMutex, portMAX_DELAY);
    const bool haveFrame = receiver.pop(frame);
    xSemaphoreGive(stateMutex);
    if (!haveFrame) break;
    bullseye::Sample sample;
    const bool valid = bullseye::decodeSample(frame, sample);
    xSemaphoreTake(stateMutex, portMAX_DELAY);
    model.link(connected, epoch, millis());
    if (connected && frame.epoch == epoch) {
      const auto result = valid ? model.apply(sample, frame, millis()) : bullseye::Ack::Invalid;
      if (result != bullseye::Ack::Applied) ++model.errors;
      sendAckLocked(result, valid ? sample.seq : 0);
    }
    xSemaphoreGive(stateMutex);
  }

  now = millis();
  if (touchBusStarted && !touchReady && static_cast<uint32_t>(now - lastTouchAttempt) >= 5000) {
    lastTouchAttempt = now; touchReady = touchController.begin();
  }
  if (touchReady && static_cast<uint32_t>(now - lastTouch) >= 20) {
    lastTouch = now;
    const auto frame = touchController.poll();
    if (frame.state == onebox::TouchState::Error) {
      touchReady = false; lastTouchAttempt = now; gestures.cancel();
    } else {
      const auto gesture = gestures.update(frame, now);
      bullseye::handleGesture(model, gesture, now);
    }
  }
  if (static_cast<uint32_t>(now - lastRender) >= 100) {
    lastRender = now;
    companionController.updateMotion(millis());
    renderer.render(screen, model, touchReady ? touchController.name() : "unavailable", now);
    companionController.updateMotion(millis());
  }
  delay(1);
}
