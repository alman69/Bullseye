// ===== esp32-companion/CompanionHttp.h =====

#include <stdint.h>
#include <stddef.h>
#include <string.h>
#include <stdio.h>
#include <ctype.h>
#include <limits.h>

namespace companion {
enum class Command : uint8_t { Invalid, Status, Squeeze, Release, Home, Stop, Relax };
inline const char* commandName(Command command) {
  switch (command) {
    case Command::Status: return "status";
    case Command::Squeeze: return "squeeze";
    case Command::Release: return "release";
    case Command::Home: return "home";
    case Command::Stop: return "stop";
    case Command::Relax: return "relax";
    default: return "invalid";
  }
}
inline Command commandFrom(const char* name) {
  for (uint8_t i = 1; i <= 6; ++i) if (!strcmp(name, commandName(static_cast<Command>(i)))) return static_cast<Command>(i);
  return Command::Invalid;
}
inline bool unsigned32(const char* text, uint32_t& value) {
  if (!text || !*text) return false;
  uint32_t result = 0;
  for (const char* c = text; *c; ++c) {
    if (*c < '0' || *c > '9') return false;
    const uint32_t digit = *c - '0';
    if (result > (UINT32_MAX - digit) / 10) return false;
    result = result * 10 + digit;
  }
  value = result; return true;
}
inline bool equalsIgnoreCase(const char* first, const char* second) {
  while (*first && *second) {
    if (tolower(static_cast<unsigned char>(*first++)) != tolower(static_cast<unsigned char>(*second++))) return false;
  }
  return *first == *second;
}

struct Request {
  Command command = Command::Invalid;
  uint32_t boot = 0, sequence = 0;
  int error = 400;
};

// Small fixed-endpoint HTTP/1.x decoder. No body, chunked transfer, keep-alive,
// dynamic allocation, blocking reads or unbounded request processing.
class HttpDecoder {
 public:
  static constexpr size_t capacity = 1536;
  static constexpr uint32_t timeoutMs = 500;
  void reset(uint32_t now) { length_ = 0; ready_ = false; error_ = 0; started_ = now; }
  bool expired(uint32_t now) const { return static_cast<uint32_t>(now - started_) >= timeoutMs; }
  bool ready() const { return ready_; }
  void feed(const uint8_t* data, size_t count) {
    for (size_t i = 0; i < count && !ready_; ++i) {
      const uint8_t c = data[i];
      if ((c < 32 && c != '\r' && c != '\n' && c != '\t') || c > 126) { error_ = 400; ready_ = true; break; }
      if (length_ == capacity - 1) { error_ = 431; ready_ = true; break; }
      text_[length_++] = static_cast<char>(c);
      text_[length_] = '\0';
      if (length_ >= 4 && !memcmp(text_ + length_ - 4, "\r\n\r\n", 4)) ready_ = true;
    }
  }
  Request decode() {
    Request result;
    if (!ready_) return result;
    if (error_) { result.error = error_; return result; }
    char* end = strstr(text_, "\r\n");
    if (!end || end - text_ > 224) return result;
    *end = '\0';
    char method[8], path[192], version[16], extra;
    if (sscanf(text_, "%7s %191s %15s %c", method, path, version, &extra) != 3 ||
        (strcmp(version, "HTTP/1.1") && strcmp(version, "HTTP/1.0"))) return result;
    bool contentLengthSeen = false;
    for (char* header = end + 2; *header;) {
      char* next = strstr(header, "\r\n");
      if (!next) return result;
      if (next == header) break;
      *next = '\0';
      char* colon = strchr(header, ':');
      if (!colon || colon == header || *header == ' ' || *header == '\t') return result;
      *colon = '\0';
      char* value = colon + 1;
      while (*value == ' ' || *value == '\t') ++value;
      char* tail = value + strlen(value);
      while (tail > value && (tail[-1] == ' ' || tail[-1] == '\t')) *--tail = '\0';
      if (equalsIgnoreCase(header, "Transfer-Encoding")) return result;
      if (equalsIgnoreCase(header, "Content-Length")) {
        uint32_t length = 0;
        if (contentLengthSeen || !unsigned32(value, length)) return result;
        contentLengthSeen = true;
        if (length != 0) { result.error = 413; return result; }
      }
      header = next + 2;
    }
    if (!strcmp(path, "/status")) {
      if (strcmp(method, "GET")) { result.error = 405; return result; }
      result.command = Command::Status; result.error = 0; return result;
    }
    constexpr const char* prefix = "/command?";
    if (strncmp(path, prefix, strlen(prefix))) { result.error = 404; return result; }
    if (strcmp(method, "POST")) { result.error = 405; return result; }
    unsigned fields = 0;
    for (char* pair = path + strlen(prefix); pair && *pair;) {
      char* next = strchr(pair, '&'); if (next) *next++ = '\0';
      char* equal = strchr(pair, '='); if (!equal) return result;
      *equal++ = '\0';
      unsigned field;
      if (!strcmp(pair, "name")) { field = 1; result.command = commandFrom(equal); }
      else if (!strcmp(pair, "boot")) { field = 2; if (!unsigned32(equal, result.boot)) return result; }
      else if (!strcmp(pair, "seq")) { field = 4; if (!unsigned32(equal, result.sequence)) return result; }
      else return result;
      if (fields & field) return result;
      fields |= field; pair = next;
    }
    if (result.command == Command::Invalid || result.command == Command::Status) return result;
    if (fields != 7 || !result.boot || !result.sequence) { result.error = 409; return result; }
    result.error = 0; return result;
  }
 private:
  char text_[capacity] = {};
  size_t length_ = 0;
  uint32_t started_ = 0;
  bool ready_ = false;
  int error_ = 0;
};

// A newer STOP invalidates older packets even if a transport delivers them late.
class CommandOrder {
 public:
  explicit CommandOrder(uint32_t boot = 1) : boot_(boot ? boot : 1) {}
  void begin(uint32_t boot) { boot_ = boot ? boot : 1; sequence_ = 0; }
  bool accept(uint32_t boot, uint32_t sequence) {
    if (boot != boot_ || sequence == 0 || sequence <= sequence_) return false;
    sequence_ = sequence; return true;
  }
  void fence() { if (sequence_ < UINT32_MAX) ++sequence_; }
  uint32_t boot() const { return boot_; }
  uint32_t sequence() const { return sequence_; }
 private:
  uint32_t boot_, sequence_ = 0;
};
}  // namespace companion


// ===== esp32-companion/CompanionControl.h =====



namespace companion {
enum class StopReason : uint8_t { None, ContactTimeout, LinkLost };
inline const char* stopReasonName(StopReason reason) {
  return reason == StopReason::ContactTimeout ? "control-heartbeat-timeout" : reason == StopReason::LinkLost ? "BLE-link-loss" : "none";
}
// Shared by the actual sketch and native integration checks. Only this main-loop
// controller changes servo targets; telemetry alone never renews motion control.
template <class Out> class Control {
 public:
  explicit Control(Out& out) : arm_(out) {}
  bool begin(uint32_t now, uint32_t boot) {
    order_.begin(boot); servoReady_ = arm_.begin(now); return servoReady_;
  }
  void outputReady(bool ready) { servoReady_ &= ready; if (!servoReady_) arm_.relax(); }
  const scooper::Scooper<Out>& arm() const { return arm_; }
  const CommandOrder& order() const { return order_; }
  bool servoReady() const { return servoReady_; }
  bool watchdogStopped() const { return watchdogStopped_; }
  StopReason stopReason() const { return stopReason_; }
  uint32_t contactAge(uint32_t now) const { return contactSeen_ ? static_cast<uint32_t>(now - lastContact_) : UINT32_MAX; }
  const char* execute(const Request& request, uint32_t now) {
    if (request.error) return "unsupported request";
    if (request.command == Command::Status) { lastContact_ = now; contactSeen_ = true; return nullptr; }
    if (!order_.accept(request.boot, request.sequence)) return "old command or board restarted; reconnect";
    lastContact_ = now; contactSeen_ = true;
    return run(request.command, now, true);
  }
  const char* local(Command command, uint32_t now) { return run(command, now, false); }
  bool setJoint(uint8_t joint, int degrees, uint16_t speed) {
    if (!servoReady_ || !arm_.setJoint(joint, degrees, speed)) return false;
    order_.fence(); wirelessMotion_ = false; watchdogStopped_ = false; stopReason_ = StopReason::None; return true;
  }
  void connectionLost() {
    if (wirelessMotion_ && moving()) stopWireless(StopReason::LinkLost);
    else wirelessMotion_ = false;
  }
  void tick(uint32_t now, bool link) {
    if (linkWasConnected_ && !link) connectionLost();
    linkWasConnected_ = link;
    if (wirelessMotion_ && moving() && static_cast<uint32_t>(now - lastContact_) >= 2000) stopWireless(StopReason::ContactTimeout);
    arm_.update(now);
    if (!moving()) wirelessMotion_ = false;
  }
 private:
  bool moving() const { return arm_.state() == scooper::State::Moving || arm_.state() == scooper::State::Sequence; }
  void stopWireless(StopReason reason) { arm_.stop(); order_.fence(); wirelessMotion_ = false; watchdogStopped_ = true; stopReason_ = reason; }
  const char* run(Command command, uint32_t now, bool wireless) {
    if (command == Command::Stop || command == Command::Relax) {
      if (command == Command::Stop) arm_.stop(); else arm_.relax();
      wirelessMotion_ = false;
      watchdogStopped_ = false; stopReason_ = StopReason::None;
      if (!wireless) order_.fence();
      return nullptr;
    }
    if (!servoReady_) return "servo PWM initialization failed; inspect pins and restart";
    bool ok = false;
    if (command == Command::Squeeze) ok = arm_.squeeze();
    else if (command == Command::Release) ok = arm_.release();
    else if (command == Command::Home) ok = arm_.home();
    else return "unknown command";
    if (!ok) return arm_.error();
    wirelessMotion_ = wireless; watchdogStopped_ = false; stopReason_ = StopReason::None;
    if (wireless) { lastContact_ = now; contactSeen_ = true; }
    return nullptr;
  }
  scooper::Scooper<Out> arm_;
  CommandOrder order_;
  uint32_t lastContact_ = 0;
  StopReason stopReason_ = StopReason::None;
  bool contactSeen_ = false;
  bool servoReady_ = false, wirelessMotion_ = false, watchdogStopped_ = false, linkWasConnected_ = false;
};
}  // namespace companion


// ===== esp32-companion/CompanionBle.h =====


namespace companion {
constexpr const char* kCommandUuid = "3f7c1003-6f54-4a9c-8b2d-56e39a18c201";
constexpr const char* kStatusUuid = "3f7c1004-6f54-4a9c-8b2d-56e39a18c201";
enum class Result : uint8_t { Status, Applied, Invalid, Old, Refused, Overflow };
inline uint32_t read32(const uint8_t* p) {
  return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
         (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24);
}
inline void write32(uint8_t* p, uint32_t value) { for (uint8_t i = 0; i < 4; ++i) p[i] = static_cast<uint8_t>(value >> (8 * i)); }
struct CommandFrame { uint8_t bytes[12] = {}; uint32_t epoch = 0; };
inline Request decodeCommand(const CommandFrame& frame) {
  const auto* p = frame.bytes;
  if (p[0] != 'B' || p[1] != 'C' || p[2] != 1 || p[3] > 5) return {};
  const Command commands[] = {Command::Status, Command::Squeeze, Command::Release, Command::Home, Command::Stop, Command::Relax};
  const uint32_t boot = read32(p + 4), seq = read32(p + 8);
  if (!boot || (p[3] == 0 ? seq != 0 : seq == 0)) return {};
  return {commands[p[3]], boot, seq, 0};
}
// Called only under the shared state mutex. A fixed-size write fits even MTU 23.
// Callbacks copy bytes; the main loop validates commands and controls the servos.
class CommandMailbox {
 public:
  void reset() { count_ = 0; error_ = Result::Status; }
  void feed(const uint8_t* bytes, size_t count, uint32_t epoch) {
    if (count != 12) { error_ = Result::Invalid; return; }
    if (count_ == 2) {
      if (bytes[0] == 'B' && bytes[1] == 'C' && bytes[2] == 1 && bytes[3] == 4) count_ = 0;
      else { error_ = Result::Overflow; return; }
    }
    memcpy(frames_[count_].bytes, bytes, 12); frames_[count_++].epoch = epoch;
  }
  bool pop(CommandFrame& frame) {
    if (!count_) return false;
    frame = frames_[0]; if (--count_) frames_[0] = frames_[1]; return true;
  }
  Result takeError() { const Result error = error_; error_ = Result::Status; return error; }
 private:
  CommandFrame frames_[2]; uint8_t count_ = 0; Result error_ = Result::Status;
};
template<class Out> Result apply(Control<Out>& control, const CommandFrame& frame, uint32_t now) {
  const Request request = decodeCommand(frame);
  if (request.error) return Result::Invalid;
  if (request.boot != control.order().boot()) return Result::Old;
  if (request.command != Command::Status && request.sequence <= control.order().sequence()) return Result::Old;
  return control.execute(request, now) ? Result::Refused : Result::Applied;
}
template<class Out> void encodeStatus(uint8_t* out, const Control<Out>& control, Result result, uint32_t reply) {
  const auto& arm = control.arm();
  out[0] = 'B'; out[1] = 'C'; out[2] = 1; out[3] = static_cast<uint8_t>(result);
  write32(out + 4, control.order().boot()); write32(out + 8, control.order().sequence()); write32(out + 12, reply);
  out[16] = (control.servoReady() ? 1 : 0) | (control.watchdogStopped() ? 2 : 0) |
            (static_cast<uint8_t>(arm.state()) << 2) | (!strcmp(arm.sequenceName(), "release") ? 16 : 0);
  out[17] = static_cast<uint8_t>(arm.angle(0)); out[18] = static_cast<uint8_t>(arm.angle(1));
  out[19] = arm.state() == scooper::State::Sequence ? arm.stepIndex() + 1 : 0;
}
}  // namespace companion


// ===== esp32-companion/CompanionRuntime.h =====

#include <Arduino.h>
#include <esp_random.h>


namespace companion {
class Runtime {
 public:
  Runtime() : servos_(pwm_), control_(servos_) {}
  CommandMailbox mailbox;
  void begin() {
    bool output = control_.begin(millis(), esp_random());
    output &= servos_.initialized();
    control_.outputReady(output);
    if (!output) Serial.println("Scooper PWM failed; motion disabled until restart.");
    Serial.println("Combined BLE display + scooper ready. Serial: status, pwm, stop, relax, home, squeeze, release, set 1|2 degrees [speed].");
    printStatus();
  }
  void poll(uint32_t now) {
    if (havePoll_) { const uint32_t gap = now - lastPoll_; if (gap > maxLoopGap_) maxLoopGap_ = gap; }
    havePoll_ = true; lastPoll_ = now;
    readSerial(now); updateMotion(millis());
  }
  // Main loop only. Epoch fencing handles a disconnect/reconnect between ticks.
  void link(bool connected, uint32_t epoch, uint32_t now) {
    if (epoch != epoch_) { control_.connectionLost(); epoch_ = epoch; }
    connected_ = connected; updateMotion(now);
  }
  void updateMotion(uint32_t now) {
    control_.outputReady(servos_.healthy());
    if (control_.watchdogStopped() && reportedStop_ != control_.stopReason()) {
      reportedStop_ = control_.stopReason();
      Serial.printf("Scooper stopped: %s control_age_ms=%lu max_loop_gap_ms=%lu\n", stopReasonName(reportedStop_),
        static_cast<unsigned long>(control_.contactAge(now)), static_cast<unsigned long>(maxLoopGap_));
    } else if (!control_.watchdogStopped()) reportedStop_ = StopReason::None;
    control_.tick(now, connected_);
    control_.outputReady(servos_.healthy());
  }
  Result execute(const CommandFrame& frame, uint32_t now) {
    control_.outputReady(servos_.healthy());
    const Result result = apply(control_, frame, now);
    control_.outputReady(servos_.healthy());
    const Command command = decodeCommand(frame).command;
    if (result == Result::Applied && !control_.servoReady() && command != Command::Status && command != Command::Stop) return Result::Refused;
    return result;
  }
  void status(uint8_t* out, Result result = Result::Status, uint32_t reply = 0) const { encodeStatus(out, control_, result, reply); }
 private:
  void printStatus() const {
    const auto& arm = control_.arm();
    Serial.printf("BLE scooper boot=%lu seq=%lu ready=%d state=%s left=%d right=%d watchdog=%d\n",
      static_cast<unsigned long>(control_.order().boot()), static_cast<unsigned long>(control_.order().sequence()),
      control_.servoReady(), scooper::stateName(arm.state()), arm.angle(0), arm.angle(1), control_.watchdogStopped());
    Serial.printf("Diagnostics: stop_reason=%s control_age_ms=%lu max_loop_gap_ms=%lu PWM_fault=%s\n",
      stopReasonName(control_.stopReason()), static_cast<unsigned long>(control_.contactAge(millis())),
      static_cast<unsigned long>(maxLoopGap_), pwmFaultName(servos_.fault()));
  }
  void serialCommand() {
    line_[lineLength_] = '\0';
    char* name = strtok(line_, " \t"); if (!name) return;
    if (!strcmp(name, "status")) { printStatus(); return; }
    if (!strcmp(name, "pwm")) {
      for (uint8_t i = 0; i < scooper::kJointCount; ++i) {
        const uint8_t pin = scooper::kJoints[i].pin;
        Serial.printf("PWM %s GPIO%u: frequency_hz=%lu duty=%lu / 16384\n", scooper::kJoints[i].name, pin,
          static_cast<unsigned long>(ledcReadFreq(pin)), static_cast<unsigned long>(ledcRead(pin)));
      }
      Serial.println("Readback is PWM register state, not measured shaft position. Wait >20 ms after a move before reading.");
      return;
    }
    if (!strcmp(name, "x")) name = const_cast<char*>("stop");
    if (!strcmp(name, "set")) {
      uint32_t joint = 0, degrees = 0, speed = scooper::kDefaultDegPerSec;
      const char* speedText;
      if (!unsigned32(strtok(nullptr, " \t"), joint) || !unsigned32(strtok(nullptr, " \t"), degrees) ||
          ((speedText = strtok(nullptr, " \t")) && !unsigned32(speedText, speed)) || strtok(nullptr, " \t") ||
          joint < 1 || joint > 2 || degrees > 180 || speed < 1 || speed > 600 || !control_.servoReady()) { Serial.println("error: set 1|2 degrees [speed 1-600]"); return; }
      if (!control_.setJoint(joint - 1, static_cast<int>(degrees), speed)) Serial.printf("error: %s\n", control_.arm().error());
      else Serial.println("ok");
      return;
    }
    if (strtok(nullptr, " \t")) { Serial.println("error: unexpected arguments"); return; }
    const char* error = control_.local(commandFrom(name), millis());
    if (error) Serial.printf("error: %s\n", error); else { Serial.println("ok"); printStatus(); }
  }
  void readSerial(uint32_t now) {
    if (lineLength_ && static_cast<uint32_t>(now - lineStarted_) >= 2000) { lineLength_ = 0; lineOverflow_ = true; }
    for (int budget = 128; budget > 0 && Serial.available(); --budget) {
      const char c = static_cast<char>(Serial.read());
      if (c == '\r' || c == '\n') {
        if (lineOverflow_) Serial.println("error: oversized, invalid or expired serial line");
        else if (lineLength_) serialCommand();
        lineLength_ = 0; lineOverflow_ = false;
      } else if (c < 32 || c > 126 || lineLength_ == sizeof(line_) - 1) lineOverflow_ = true;
      else if (!lineOverflow_) { if (!lineLength_) lineStarted_ = now; line_[lineLength_++] = c; }
    }
  }
  ArduinoServoPwm pwm_;
  ServoPwm<ArduinoServoPwm> servos_;
  Control<ServoPwm<ArduinoServoPwm>> control_;
  char line_[64] = {};
  size_t lineLength_ = 0;
  uint32_t lineStarted_ = 0, epoch_ = 0;
  uint32_t lastPoll_ = 0, maxLoopGap_ = 0;
  StopReason reportedStop_ = StopReason::None;
  bool havePoll_ = false;
  bool connected_ = false, lineOverflow_ = false;
};
}  // namespace companion


