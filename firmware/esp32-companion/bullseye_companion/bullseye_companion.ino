// Bullseye Companion: ONE FILE for ESP32-S3 display + scooper over ONE BLE connection.
// Generated by firmware/esp32-companion/generate.py. No repository headers needed to upload.
// Core 3.3.12 / 32MB OPI flash / OPI PSRAM / Default 4MB with spiffs / CDC disabled.
// Existing DFRobot_GDL, Adafruit GFX and BusIO libraries remain required.
// Servos: GPIO39/40, separate 5V supply sharing GND; both command 90 degrees on boot.


// ===== esp32-display/bullseye_display/PixelFace.h =====

#include <stdint.h>
#include <string.h>

namespace bullseye {
constexpr uint16_t kNavy = 0x0884, kCream = 0xef3a, kSteel = 0x326c, kRed = 0xe1c5;
constexpr uint8_t kDistancePage = 0, kLinkPage = 1, kFacePage = 2, kPageCount = 3;
enum class Mood : uint8_t { Idle, Happy, Curious, Grumpy, Sleepy };
inline const char* moodName(Mood mood) {
  switch (mood) {
    case Mood::Happy: return "HAPPY";
    case Mood::Curious: return "CURIOUS";
    case Mood::Grumpy: return "GRUMPY";
    case Mood::Sleepy: return "SLEEPY";
    default: return "IDLE";
  }
}

// Local animation only: no sensor thresholds, BLE fields or rover commands.
class FaceController {
 public:
  Mood mood(uint32_t now) const {
    const uint32_t steps = automatic_ ? static_cast<uint32_t>(now - changedAt_) / 4000 : 0;
    return static_cast<Mood>((static_cast<uint8_t>(selected_) + steps) % 5);
  }
  uint32_t elapsed(uint32_t now) const {
    const uint32_t age = now - changedAt_;
    return automatic_ ? age % 4000 : age;
  }
  bool automatic() const { return automatic_; }
  void select(Mood mood, uint32_t now) { selected_ = mood; automatic_ = false; changedAt_ = now; }
  void next(uint32_t now) {
    selected_ = static_cast<Mood>((static_cast<uint8_t>(mood(now)) + 1) % 5);
    automatic_ = false; changedAt_ = now;
  }
  void toggleAuto(uint32_t now) {
    selected_ = mood(now); automatic_ = !automatic_; changedAt_ = now;
  }
 private:
  Mood selected_ = Mood::Happy;
  bool automatic_ = true;
  uint32_t changedAt_ = 0;
};

enum class Ink : uint8_t { Navy, Cream, Steel, Red };
// Eight-pixel cells enlarge the approved artwork across the entire LCD. Two tiny buffers replace
// a full-screen framebuffer; only changed horizontal runs reach the SPI display.
struct FaceFrame {
  static constexpr int columns = 60, rows = 40, cell = 8, x = 0, y = 0;
  uint8_t cells[columns * rows] = {};
  void rect(int left, int top, int width, int height, Ink ink = Ink::Cream) {
    left += 5; top += 5;  // Center the original face geometry in 480x320.
    for (int row = top; row < top + height; ++row) {
      if (row < 0 || row >= rows) continue;
      for (int col = left; col < left + width; ++col) {
        if (col >= 0 && col < columns) cells[row * columns + col] = static_cast<uint8_t>(ink);
      }
    }
  }
};

inline FaceFrame pixelFace(Mood mood, uint32_t elapsed) {
  FaceFrame frame;
  const bool blink = elapsed % 3800 >= 3500 && elapsed % 3800 < 3700;
  const int bob = mood == Mood::Happy && elapsed % 800 >= 400 ? 1 : 0;
  const int glance = mood == Mood::Curious ? static_cast<int>((elapsed / 600) % 4) - 1 : 0;
  const int gaze = glance > 1 ? 0 : glance;
  const int twitch = mood == Mood::Grumpy && elapsed % 2200 >= 1900 ? 1 : 0;
  const int breath = mood == Mood::Sleepy && elapsed % 1600 >= 800 ? 1 : 0;
  for (int index = 0; index < 2; ++index) {
    const int center = index == 0 ? 12 : 37;
    if (mood == Mood::Happy) {
      frame.rect(center - 5, 4 + bob, 3, 1);
      frame.rect(center - 2, 3 + bob, 5, 1);
      frame.rect(center + 3, 4 + bob, 3, 1);
      if (blink) frame.rect(center - 4, 13 + bob, 9, 1);
      else {
        frame.rect(center - 5, 11 + bob, 2, 4);
        frame.rect(center - 3, 10 + bob, 2, 2);
        frame.rect(center - 1, 9 + bob, 3, 2);
        frame.rect(center + 2, 10 + bob, 2, 2);
        frame.rect(center + 4, 11 + bob, 2, 4);
      }
    } else if (mood == Mood::Sleepy) {
      frame.rect(center - 4, 8, 9, 1, Ink::Steel);
      frame.rect(center - 5, 13 + breath, 3, 1);
      frame.rect(center - 2, 14 + breath, 5, 1);
      frame.rect(center + 3, 13 + breath, 3, 1);
    } else {
      if (mood == Mood::Grumpy) {
        frame.rect(center - 5, (index == 0 ? 4 : 7) + twitch, 5, 2, Ink::Red);
        frame.rect(center, (index == 0 ? 7 : 4) + twitch, 6, 2, Ink::Red);
        if (blink) frame.rect(center - 4, 13, 9, 1);
        else {
          frame.rect(center - 4, 11, 9, 6);
          for (int row = 0; row < 3; ++row) {
            const int cut = 6 - row * 2;
            frame.rect(center - 4 + (index == 0 ? 0 : cut), 8 + row, 9 - cut, 1);
          }
        }
      } else {
        if (mood == Mood::Curious) {
          const int raise = index == 0 && elapsed % 1600 >= 800 ? 1 : 0;
          frame.rect(center - 5, (index == 0 ? 3 : 6) - raise, 5, 1);
          frame.rect(center, (index == 0 ? 2 : 6) - raise, 6, 1);
        } else frame.rect(center - 4, 4, 9, 1, Ink::Steel);
        if (blink) frame.rect(center - 4 + gaze, 13, 9, 1);
        else frame.rect(center - 4 + gaze, mood == Mood::Curious && index == 1 ? 10 : 7,
                        9, mood == Mood::Curious ? (index == 0 ? 13 : 9) : 11);
      }
    }
  }
  if (mood == Mood::Happy) {
    frame.rect(19, 20 + bob, 2, 4); frame.rect(21, 23 + bob, 2, 2);
    frame.rect(23, 25 + bob, 6, 2); frame.rect(29, 23 + bob, 2, 2); frame.rect(31, 20 + bob, 2, 4);
    frame.rect(3, 17 + bob, 3, 1, Ink::Red); frame.rect(46, 17 + bob, 3, 1, Ink::Red);
  } else if (mood == Mood::Grumpy) {
    frame.rect(21, 25, 2, 2); frame.rect(23, 24, 2, 1); frame.rect(25, 23, 4, 1);
    frame.rect(29, 24, 2, 1); frame.rect(31, 25, 2, 2);
    const int pulse = (elapsed / 300) % 2;
    frame.rect(50, 5 + pulse, 1, 3, Ink::Red); frame.rect(52, 8 + pulse, 3, 1, Ink::Red);
  } else if (mood == Mood::Sleepy) {
    frame.rect(24, 22, 4, 1); frame.rect(24, 25 + breath, 4, 1);
    frame.rect(24, 23, 1, 2 + breath); frame.rect(27, 23, 1, 2 + breath);
    const int drift = (elapsed / 500) % 3;
    frame.rect(46, 3 - drift, 4, 1, Ink::Red); frame.rect(48, 4 - drift, 1, 1, Ink::Red);
    frame.rect(47, 5 - drift, 1, 1, Ink::Red); frame.rect(46, 6 - drift, 4, 1, Ink::Red);
  } else if (mood == Mood::Curious) {
    frame.rect(23, 23, 5, 1); frame.rect(28, 22, 1, 2); frame.rect(29, 22, 3, 1);
  } else {
    frame.rect(22, 22, 1, 1); frame.rect(22, 23, 8, 1); frame.rect(29, 22, 1, 1);
  }
  return frame;
}

class FaceRenderer {
 public:
  void invalidate() { valid_ = false; }
  template <class Screen> void render(Screen& screen, const FaceController& controller, uint32_t now) {
    const FaceFrame next = pixelFace(controller.mood(now), controller.elapsed(now));
    constexpr uint16_t palette[] = {kNavy, kCream, kSteel, kRed};
    for (int row = 0; row < FaceFrame::rows; ++row) {
      int col = 0;
      while (col < FaceFrame::columns) {
        const int index = row * FaceFrame::columns + col;
        const auto ink = next.cells[index];
        if ((valid_ && ink == previous_.cells[index]) || (!valid_ && ink == 0)) { ++col; continue; }
        const int start = col++;
        while (col < FaceFrame::columns && next.cells[row * FaceFrame::columns + col] == ink &&
               (!valid_ || previous_.cells[row * FaceFrame::columns + col] != ink)) ++col;
        screen.fillRect(FaceFrame::x + start * FaceFrame::cell, FaceFrame::y + row * FaceFrame::cell,
                        (col - start) * FaceFrame::cell, FaceFrame::cell, palette[ink]);
      }
    }
    previous_ = next; valid_ = true;
  }
 private:
  FaceFrame previous_;
  bool valid_ = false;
};
}  // namespace bullseye


// ===== esp32-display/bullseye_display/DisplayProtocol.h =====

#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <string.h>
#include <limits.h>

namespace bullseye {
constexpr char kServiceUuid[] = "3f7c1000-6f54-4a9c-8b2d-56e39a18c201";
constexpr char kRxUuid[] = "3f7c1001-6f54-4a9c-8b2d-56e39a18c201";
constexpr char kAckUuid[] = "3f7c1002-6f54-4a9c-8b2d-56e39a18c201";
constexpr size_t kMaxFrame = 256;  // Includes newline; storage ends with NUL instead.
constexpr uint32_t kPartialTimeoutMs = 2000, kSampleStaleMs = 1500, kDataTimeoutMs = 3000;
enum class Ack : uint8_t { Applied = 0, Invalid = 1, Overflow = 2, Old = 3 };
enum class Status : uint8_t { Live, Stale, Invalid, Unavailable };
enum class Expression : uint8_t { Auto, Happy };
enum class Source : uint8_t { Rover, Demo };

inline void encodeAck(uint8_t out[8], Ack status, uint32_t seq) {
  out[0] = 'B'; out[1] = 'S'; out[2] = 1; out[3] = static_cast<uint8_t>(status);
  for (uint8_t i = 0; i < 4; ++i) out[4 + i] = static_cast<uint8_t>(seq >> (8 * i));
}

struct Frame {
  char text[kMaxFrame] = {};
  uint16_t length = 0;
  uint32_t epoch = 0, startedMs = 0;
};

// External synchronization is provided by the Arduino adapter. No heap allocation
// or JSON parsing occurs here; the BLE callback only frames and queues bytes.
class Receiver {
 public:
  void reset() { length_ = count_ = head_ = 0; dropping_ = false; error_ = 0; }
  void expire(uint32_t now) {
    if (length_ && static_cast<uint32_t>(now - started_) >= kPartialTimeoutMs) {
      length_ = 0; dropping_ = true; error_ = static_cast<uint8_t>(Ack::Invalid);
    }
  }
  void feed(const uint8_t* bytes, size_t size, uint32_t now, uint32_t epoch) {
    expire(now);
    for (size_t i = 0; i < size; ++i) {
      const uint8_t c = bytes[i];
      if (dropping_) { if (c == '\n') dropping_ = false; continue; }
      if (c == '\n') {
        if (length_ == 0) { error_ = static_cast<uint8_t>(Ack::Invalid); continue; }
        if (count_ == 2) error_ = static_cast<uint8_t>(Ack::Overflow);
        else {
          Frame& frame = queue_[(head_ + count_) % 2];
          memcpy(frame.text, buffer_, length_);
          frame.text[length_] = '\0';
          frame.length = length_; frame.epoch = epoch; frame.startedMs = started_;
          ++count_;
        }
        length_ = 0;
      } else if (length_ == kMaxFrame - 1) {
        length_ = 0; dropping_ = true; error_ = static_cast<uint8_t>(Ack::Overflow);
      } else {
        if (length_ == 0) started_ = now;
        buffer_[length_++] = static_cast<char>(c);
      }
    }
  }
  bool pop(Frame& frame) {
    if (!count_) return false;
    frame = queue_[head_]; head_ = (head_ + 1) % 2; --count_; return true;
  }
  uint8_t takeError() { const uint8_t error = error_; error_ = 0; return error; }
  void reject() { error_ = static_cast<uint8_t>(Ack::Invalid); }
 private:
  Frame queue_[2];
  char buffer_[kMaxFrame] = {};
  uint16_t length_ = 0;
  uint8_t count_ = 0, head_ = 0, error_ = 0;
  bool dropping_ = false;
  uint32_t started_ = 0;
};

struct Sample {
  uint32_t seq = 0, ageMs = 0;
  uint16_t cm = 0;
  bool hasDistance = false, hasAge = false, roverConnected = false;
  Status status = Status::Unavailable;
  Source source = Source::Rover;
  Expression expression = Expression::Auto;
};

enum class ViewState : uint8_t { Disconnected, Waiting, Timeout, Unavailable, Invalid, Stale, Live };
class Model {
 public:
  void link(bool connected, uint32_t epoch, uint32_t now = 0) {
    if (connected_ != connected || epoch_ != epoch) {
      connected_ = connected; epoch_ = epoch; hasSample_ = false; sample_ = Sample();
      linked_ = now;
    }
  }
  Ack apply(const Sample& sample, const Frame& frame, uint32_t now) {
    if (!sample.seq) return Ack::Invalid;
    if (!connected_ || frame.epoch != epoch_) return Ack::Old;
    if (hasSample_ && sample.seq <= sample_.seq) return Ack::Old;
    if (sample.expression == Expression::Happy && !happyActive(now)) happyAt_ = now;
    sample_ = sample; hasSample_ = true; started_ = frame.startedMs; applied_ = now;
    return Ack::Applied;
  }
  uint32_t age(uint32_t now) const {
    const uint64_t value = static_cast<uint64_t>(sample_.ageMs) + static_cast<uint32_t>(now - started_);
    return value > UINT32_MAX ? UINT32_MAX : static_cast<uint32_t>(value);
  }
  ViewState state(uint32_t now) const {
    if (!connected_) return ViewState::Disconnected;
    if (!hasSample_) return static_cast<uint32_t>(now - linked_) >= kDataTimeoutMs ? ViewState::Timeout : ViewState::Waiting;
    if (static_cast<uint32_t>(now - applied_) >= kDataTimeoutMs) return ViewState::Timeout;
    if (sample_.status == Status::Invalid) return ViewState::Invalid;
    if (sample_.status == Status::Unavailable || (sample_.source == Source::Rover && !sample_.roverConnected)) return ViewState::Unavailable;
    if (sample_.status == Status::Stale || !sample_.hasAge || age(now) >= kSampleStaleMs) return ViewState::Stale;
    return sample_.hasDistance ? ViewState::Live : ViewState::Unavailable;
  }
  bool happyActive(uint32_t now) const {
    return connected_ && hasSample_ && sample_.roverConnected && sample_.source == Source::Rover &&
           sample_.expression == Expression::Happy && static_cast<uint32_t>(now - applied_) < kDataTimeoutMs;
  }
  uint8_t displayPage(uint32_t now) const { return happyActive(now) ? kFacePage : page; }
  FaceController displayFace(uint32_t now) const {
    FaceController result = face;
    if (happyActive(now)) result.select(Mood::Happy, happyAt_);
    return result;
  }
  const Sample& sample() const { return sample_; }
  bool connected() const { return connected_; }
  bool hasSample() const { return hasSample_; }
  uint32_t errors = 0;
  uint8_t page = kFacePage;
  FaceController face;
 private:
  Sample sample_;
  uint32_t epoch_ = 0, started_ = 0, applied_ = 0, linked_ = 0, happyAt_ = 0;
  bool connected_ = false, hasSample_ = false;
};

inline const char* stateLabel(ViewState state) {
  switch (state) {
    case ViewState::Disconnected: return "BLE disconnected";
    case ViewState::Waiting: return "Waiting for data";
    case ViewState::Timeout: return "Application timed out";
    case ViewState::Unavailable: return "Rover unavailable";
    case ViewState::Invalid: return "No echo / invalid";
    case ViewState::Stale: return "Stale reading";
    default: return "Live distance";
  }
}
struct DisplayText {
  char lines[9][80] = {};
};
inline DisplayText present(const Model& model, const char* touch, uint32_t now) {
  DisplayText text;
  const Sample& sample = model.sample();
  const ViewState state = model.state(now);
  snprintf(text.lines[0], 80, "%s", model.hasSample() && sample.source == Source::Demo ? "DEMO DATA" : "FIELD TELEMETRY");
  if (state == ViewState::Live) snprintf(text.lines[1], 80, "%u%s cm", sample.cm, sample.cm == 150 ? "+" : "");
  else snprintf(text.lines[1], 80, "-- cm");
  snprintf(text.lines[2], 80, "%s", stateLabel(state));
  if (model.hasSample() && sample.hasAge) snprintf(text.lines[3], 80, "Sample age: %lu.%lu s | UNCALIBRATED", static_cast<unsigned long>(model.age(now) / 1000), static_cast<unsigned long>((model.age(now) % 1000) / 100));
  else snprintf(text.lines[3], 80, "Sample age: unknown | UNCALIBRATED");
  snprintf(text.lines[4], 80, "%s", model.connected() ? "Connected" : "Disconnected");
  const bool current = state != ViewState::Disconnected && state != ViewState::Waiting && state != ViewState::Timeout;
  snprintf(text.lines[5], 80, "%s", !current ? "Unknown" : sample.source == Source::Demo ? "Demo (no rover)" : sample.roverConnected ? "Connected" : "Disconnected");
  snprintf(text.lines[6], 80, "%lu", static_cast<unsigned long>(model.hasSample() ? sample.seq : 0));
  snprintf(text.lines[7], 80, "%s", touch);
  snprintf(text.lines[8], 80, "%lu", static_cast<unsigned long>(model.errors));
  return text;
}
}  // namespace bullseye


// ===== esp32-display/bullseye_display/DisplayJson.h =====

#include <math.h>
#include <string.h>
#include <cJSON.h>

namespace bullseye {
inline bool jsonUint(const cJSON* item, uint32_t& value, uint32_t min = 0) {
  if (!cJSON_IsNumber(item) || !isfinite(item->valuedouble) || item->valuedouble < min ||
      item->valuedouble > UINT32_MAX || floor(item->valuedouble) != item->valuedouble) return false;
  value = static_cast<uint32_t>(item->valuedouble); return true;
}
inline bool decodeSample(const Frame& frame, Sample& sample) {
  if (!frame.length || frame.length >= kMaxFrame || frame.text[frame.length] != '\0' ||
      memchr(frame.text, '\0', frame.length) || strstr(frame.text, "\\u0000")) return false;
  const char* end = nullptr;
  cJSON* root = cJSON_ParseWithLengthOpts(frame.text, frame.length + 1, &end, true);
  if (!root) return false;
  bool valid = cJSON_IsObject(root) && end == frame.text + frame.length;
  constexpr const char* names[] = {"v", "seq", "distance_cm", "status", "sample_age_ms", "rover_connected", "source", "expression"};
  unsigned fields = 0;
  for (const cJSON* child = root->child; child && valid; child = child->next) {
    unsigned index = 0;
    for (; index < 8 && strcmp(child->string ? child->string : "", names[index]); ++index) {}
    if (index == 8 || fields & (1u << index)) valid = false;
    else fields |= 1u << index;
  }
  valid = valid && (fields == 127 || fields == 255);
  if (valid) {
    const auto field = [root](const char* name) { return cJSON_GetObjectItemCaseSensitive(root, name); };
    uint32_t version = 0, distance = 0;
    const cJSON* cm = field("distance_cm");
    const cJSON* age = field("sample_age_ms");
    const cJSON* status = field("status");
    const cJSON* source = field("source");
    const cJSON* expression = field("expression");
    sample.expression = Expression::Auto;
    valid = jsonUint(field("v"), version) && version == 1 && jsonUint(field("seq"), sample.seq, 1) &&
            cJSON_IsBool(field("rover_connected")) && cJSON_IsString(status) && cJSON_IsString(source);
    sample.roverConnected = cJSON_IsTrue(field("rover_connected"));
    sample.hasDistance = !cJSON_IsNull(cm);
    sample.hasAge = !cJSON_IsNull(age);
    valid = valid && (!sample.hasDistance || (jsonUint(cm, distance, 1) && distance <= 150)) &&
            (!sample.hasAge || jsonUint(age, sample.ageMs));
    sample.cm = static_cast<uint16_t>(distance);
    if (valid) {
      if (expression) {
        if (!cJSON_IsString(expression)) valid = false;
        else if (!strcmp(expression->valuestring, "happy")) sample.expression = Expression::Happy;
        else if (strcmp(expression->valuestring, "auto")) valid = false;
      }
      if (!strcmp(status->valuestring, "live")) sample.status = Status::Live;
      else if (!strcmp(status->valuestring, "stale")) sample.status = Status::Stale;
      else if (!strcmp(status->valuestring, "invalid")) sample.status = Status::Invalid;
      else if (!strcmp(status->valuestring, "unavailable")) sample.status = Status::Unavailable;
      else valid = false;
      if (!strcmp(source->valuestring, "rover")) sample.source = Source::Rover;
      else if (!strcmp(source->valuestring, "demo")) sample.source = Source::Demo;
      else valid = false;
      if (sample.status == Status::Live && (!sample.hasDistance || !sample.hasAge)) valid = false;
      if ((sample.status == Status::Invalid || sample.status == Status::Unavailable) && sample.hasDistance) valid = false;
    }
  }
  cJSON_Delete(root);
  return valid;
}
}  // namespace bullseye


// ===== esp32-display/bullseye_display/DisplayRenderer.h =====


namespace bullseye {
class Renderer {
 public:
  template <class Screen> void render(Screen& screen, const Model& model, const char* touch, uint32_t now) {
    const uint8_t page = model.displayPage(now);
    const bool layout = !painted_ || page_ != page;
    if (layout) {
      screen.fillScreen(kNavy); screen.setTextWrap(false);
      faceRenderer_.invalidate();
    }
    if (page == kFacePage) {
      faceRenderer_.render(screen, model.displayFace(now), now);
      page_ = page; painted_ = true;
      return;  // Full-screen face: no title, labels, status, buttons or tabs.
    }
    const DisplayText text = present(model, touch, now);
    if (layout) {
      print(screen, 12, 12, 2, "BULLSEYE", kCream);
      screen.fillRect(12, 43, 456, 2, kRed);
      if (page == kDistancePage) print(screen, 16, 65, 1, "ULTRASONIC DISTANCE", kCream);
      else if (page == kLinkPage) {
        const char* labels[] = {"Bluetooth", "Rover", "Source", "Freshness", "Last sequence", "Touch controller", "Protocol errors"};
        for (uint8_t i = 0; i < 7; ++i) print(screen, 16, 63 + i * 29, 1, labels[i], kCream);
      }
    }
    if (layout || strcmp(previous_.lines[0], text.lines[0])) field(screen, 275, 17, 194, 15, 1, text.lines[0], kCream);
    if (page == kDistancePage) {
      if (layout || strcmp(previous_.lines[1], text.lines[1])) field(screen, 16, 103, 450, 65, 6, text.lines[1], kCream);
      if (layout || strcmp(previous_.lines[2], text.lines[2])) field(screen, 16, 192, 450, 24, 2, text.lines[2], model.state(now) == ViewState::Live ? kCream : kRed);
      if (layout || strcmp(previous_.lines[3], text.lines[3])) field(screen, 16, 229, 450, 14, 1, text.lines[3], kCream);
      if (layout || strcmp(previous_.lines[4], text.lines[4]) || strcmp(previous_.lines[5], text.lines[5])) {
        char line[80]; snprintf(line, sizeof(line), "BLE: %.20s | ROVER: %.20s", text.lines[4], text.lines[5]);
        field(screen, 16, 251, 450, 12, 1, line, kCream);
      }
    } else {
      const uint8_t rows[] = {4, 5, 0, 2, 6, 7, 8};
      for (uint8_t row = 0; row < 7; ++row) {
        const uint8_t index = rows[row];
        if (layout || strcmp(previous_.lines[index], text.lines[index])) field(screen, 205, 63 + row * 29, 264, 15, 1, text.lines[index], kCream);
      }
    }
    previous_ = text; page_ = page; painted_ = true;
  }
 private:
  template <class Screen> static void print(Screen& screen, int x, int y, int size, const char* text, uint16_t color) {
    screen.setTextColor(color); screen.setTextSize(size); screen.setCursor(x, y); screen.print(text);
  }
  template <class Screen> static void field(Screen& screen, int x, int y, int width, int height, int size, const char* text, uint16_t color) {
    screen.fillRect(x, y, width, height, kNavy); print(screen, x, y, size, text, color);
  }
  DisplayText previous_;
  FaceRenderer faceRenderer_;
  bool painted_ = false;
  uint8_t page_ = 0;
};
}  // namespace bullseye


// ===== esp32-display/bullseye_display/TouchInput.h =====

#include <stdint.h>
#include <stddef.h>
#include <cstdlib>

namespace onebox {
enum class TouchState : uint8_t { NoFrame, Released, Contact, Cancel, Error };
struct TouchFrame {
  TouchState state;
  int16_t x, y;
  uint8_t id;
};
enum class GestureKind : uint8_t { None, Tap, Left, Right };
struct Gesture {
  GestureKind kind;
  int16_t x, y;
};

// Rotation 3 for the DFRobot IPS panel. Reject, never clamp bad coordinates.
inline bool mapTouch(uint16_t x, uint16_t y, bool focalTech, TouchFrame& out) {
  if (x >= 320 || y >= 480) return false;
  out.x = focalTech ? y : 479 - y;
  out.y = focalTech ? x : 319 - x;
  return true;
}

// Bus contract: exact-length reads and acknowledged writes; bounded by the
// platform adapter. No Arduino dependencies, heap allocation or scan delays.
// Sources and controller identification limits: docs/results/esp32-touch-ui-20261020.md.
template <class Bus>
class TouchController {
 public:
  explicit TouchController(Bus& bus) : bus_(bus) {}
  bool begin() {
    kind_ = 0;
    uint8_t id[4] = {}, size[4] = {};
    if (bus_.read(0x5D, 0x8140, 2, id, 4) && id[0] == '9' && id[1] == '1' && id[2] == '1' &&
        id[3] == 0 && bus_.read(0x5D, 0x8048, 2, size, 4) && (size[0] | (size[1] << 8)) == 320 &&
        (size[2] | (size[3] << 8)) == 480) {
      kind_ = 1;
    } else if (bus_.read(0x38, 0xA3, 1, id, 1) && id[0] == 0x54) {
      kind_ = 2;  // FT5436 family, not an unconditional fallback for failed reads.
    }
    return kind_ != 0;
  }
  const char* name() const { return kind_ == 1 ? "GT911" : kind_ == 2 ? "FT54xx" : "unavailable"; }
  TouchFrame poll() {
    TouchFrame out = {TouchState::Error, 0, 0, 0};
    if (kind_ == 1) {
      uint8_t status = 0, point[8] = {};
      if (!bus_.read(0x5D, 0x814E, 2, &status, 1)) return out;
      if (!(status & 0x80)) {
        out.state = TouchState::NoFrame;
        return out;
      }
      const uint8_t count = status & 15;
      if (count == 1 && !bus_.read(0x5D, 0x814F, 2, point, 8)) return out;
      // Acknowledge only after consuming the coherent ready frame.
      if (!bus_.write(0x5D, 0x814E, 0)) return out;
      out.state = count == 0 ? TouchState::Released : TouchState::Cancel;
      if (count == 1 && !(status & 0x70) && point[0] <= 4 &&
          mapTouch(point[1] | (point[2] << 8), point[3] | (point[4] << 8), false, out)) {
        out.state = TouchState::Contact;
        out.id = point[0];
      } else if (status & 0x70)
        out.state = TouchState::Cancel;
    } else if (kind_ == 2) {
      uint8_t data[7] = {};
      if (!bus_.read(0x38, 0, 1, data, sizeof(data))) return out;
      out.state = data[2] == 0 ? TouchState::Released : TouchState::Cancel;
      const uint8_t event = data[3] >> 6;
      if (data[0] != 0)
        out.state = TouchState::Cancel;
      else if (data[2] == 1 && event <= 2 && (data[5] >> 4) < 15 &&
               mapTouch(((data[3] & 15) << 8) | data[4], ((data[5] & 15) << 8) | data[6], true,
                        out)) {
        out.state = event == 1 ? TouchState::Released : TouchState::Contact;
        out.id = data[5] >> 4;
      }
    }
    return out;
  }

 private:
  Bus& bus_;
  uint8_t kind_ = 0;
};

class TouchGestures {
 public:
  void cancel() {
    active_ = false;
    blocked_ = true;
  }
  Gesture update(TouchFrame frame, uint32_t now) {
    Gesture result = {GestureKind::None, 0, 0};
    if (active_ && now - lastFrame_ > 250) cancel();
    if (frame.state == TouchState::NoFrame) return result;  // Not a finger-up event.
    if (frame.state == TouchState::Error || frame.state == TouchState::Cancel) {
      cancel();
      return result;
    }
    if (frame.state == TouchState::Released) {
      if (active_ && !blocked_) {
        const int dx = lastX_ - startX_, dy = lastY_ - startY_;
        const uint32_t elapsed = now - started_;
        result.x = startX_;
        result.y = startY_;
        if (elapsed <= 1500 && std::abs(dx) >= 70 && maxY_ <= 45 && std::abs(dx) > 2 * std::abs(dy))
          result.kind = dx < 0 ? GestureKind::Left : GestureKind::Right;
        else if (elapsed >= 30 && elapsed <= 600 && maxX_ <= 18 && maxY_ <= 18)
          result.kind = GestureKind::Tap;
      }
      active_ = blocked_ = false;
      return result;
    }
    if (frame.x < 0 || frame.x >= 480 || frame.y < 0 || frame.y >= 320) {
      cancel();
      return result;
    }
    if (blocked_) return result;
    if (!active_) {
      active_ = true;
      started_ = now;
      startX_ = frame.x;
      startY_ = frame.y;
      maxX_ = maxY_ = 0;
      id_ = frame.id;
    }
    if (frame.id != id_) {
      cancel();
      return result;
    }
    lastX_ = frame.x;
    lastY_ = frame.y;
    lastFrame_ = now;
    const int dx = std::abs(lastX_ - startX_), dy = std::abs(lastY_ - startY_);
    if (dx > maxX_) maxX_ = dx;
    if (dy > maxY_) maxY_ = dy;
    return result;
  }

 private:
  bool active_ = false, blocked_ = false;
  int16_t startX_ = 0, startY_ = 0, lastX_ = 0, lastY_ = 0;
  int maxX_ = 0, maxY_ = 0;
  uint8_t id_ = 0;
  uint32_t started_ = 0, lastFrame_ = 0;
};
}  // namespace onebox


