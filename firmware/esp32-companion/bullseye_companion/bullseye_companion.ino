// ===== esp32-scooper/bullseye_scooper/ScooperConfig.h =====

// Everything you are expected to edit lives here: pins, limits, trims and poses.
//
// Angles are "logical" degrees, the same for both sticks:
//   90 = stick pointing straight down, lower = swung outward, higher = swung inward.
// The right servo is mounted mirror-image, so `inverted` flips its angles on the way
// out (180 - angle). That makes one pose move both sticks out (or in) together.
#include <stdint.h>

namespace scooper {

constexpr uint8_t kJointCount = 2;

struct Joint {
  const char* name;  // Shown in `status` and parsed by Mission Control.
  uint8_t pin;       // ESP32-S3 GPIO number.
  uint8_t minDeg;    // Soft limits (logical degrees): commands outside are rejected.
  uint8_t maxDeg;
  uint8_t homeDeg;   // Pose at power-up and on `home`: straight down.
  int8_t trimDeg;    // Added at the servo to correct the horn's spline offset.
  bool inverted;     // Mirror-mounted servo.
};

// The squeeze, as described: start straight down, swing out ~30°, then back in
// to ~80° inward of straight down (a 110° swing that ends under the block).
constexpr uint8_t kDownDeg = 90;
constexpr uint8_t kOutDeg = kDownDeg - 30;
constexpr uint8_t kInDeg = kDownDeg + 80;

// SG90 signals: GPIO39 (left) and GPIO40 (right); moved from 41/42 for isolation testing.
// Not 35/36/37 on that header: the board's octal PSRAM uses them. Also avoid 0/45/46
// (boot strapping), 19/20 (USB), 43/44 (debug UART) and 4-13 (display + touch).
// GPIO47/48 use 1.8V logic on the N32R16V module; do not use for these servo signals.
constexpr Joint kJoints[kJointCount] = {
    {"left", 39, kOutDeg - 10, kInDeg + 5, kDownDeg, 0, false},
    {"right", 40, kOutDeg - 10, kInDeg + 5, kDownDeg, 0, true},
};

// SG90: 50 Hz, about 500 us = 0° to 2400 us = 180° (the rover's pan servo uses the same).
constexpr uint16_t kPulseMinUs = 500;
constexpr uint16_t kPulseMaxUs = 2400;
constexpr uint16_t kServoHz = 50;

constexpr uint16_t kDefaultDegPerSec = 90;

// A sequence is a short list of steps. Each step moves both sticks together at
// degPerSec (they start level and travel equally, so they arrive together), then
// waits holdMs. kKeep leaves a joint where it is.
constexpr int16_t kKeep = -1;
struct Step {
  const char* label;
  int16_t deg[kJointCount];
  uint16_t degPerSec;
  uint16_t holdMs;
};

constexpr Step kSqueezeSteps[] = {
    {"down", {kDownDeg, kDownDeg}, 90, 200},
    {"out", {kOutDeg, kOutDeg}, 90, 300},
    {"in", {kInDeg, kInDeg}, 60, 0},  // Slower, so the block is lifted, not knocked.
};
constexpr Step kReleaseSteps[] = {
    {"out", {kOutDeg, kOutDeg}, 90, 300},
    {"down", {kDownDeg, kDownDeg}, 90, 0},
};

}  // namespace scooper


// ===== esp32-scooper/bullseye_scooper/Scooper.h =====

// Scooper motion logic. No Arduino dependency, so it runs in native tests and can
// later drop into the display sketch beside the BLE and touch code. Nonblocking:
// call update() from loop(); every motion is a time-based slew toward a target.
#include <stddef.h>
#include <stdint.h>

namespace scooper {

enum class State : uint8_t {
  Relaxed,   // No PWM pulses: servos are limp. Also the state before begin().
  Holding,   // At target, holding torque.
  Moving,    // Single move (`set` or `home`) in progress.
  Sequence,  // Running squeeze or release steps.
};

inline const char* stateName(State state) {
  switch (state) {
    case State::Relaxed: return "relaxed";
    case State::Holding: return "holding";
    case State::Moving: return "moving";
    case State::Sequence: return "sequence";
  }
  return "?";
}

inline bool inLimits(uint8_t joint, int deg) {
  return deg >= kJoints[joint].minDeg && deg <= kJoints[joint].maxDeg;
}

template <size_t N>
constexpr uint8_t stepCount(const Step (&)[N]) { return static_cast<uint8_t>(N); }

// Out provides attach(joint), write(joint, servoDeg) and detach(joint).
template <class Out>
class Scooper {
 public:
  static constexpr uint32_t kMaxTickMs = 200;  // A stalled loop slows motion, never jumps.

  explicit Scooper(Out& out) : out_(out) {}

  // Checks the tables in ScooperConfig.h. Nothing moves until this passes.
  bool validate() {
    valid_ = false;
    for (uint8_t i = 0; i < kJointCount; ++i) {
      const Joint& j = kJoints[i];
      if (j.minDeg > j.maxDeg || j.maxDeg > 180 || !inLimits(i, j.homeDeg)) {
        return fail("a joint's limits or home angle are invalid");
      }
    }
    if (!stepsValid(kSqueezeSteps, stepCount(kSqueezeSteps)) ||
        !stepsValid(kReleaseSteps, stepCount(kReleaseSteps))) {
      return fail("a squeeze/release step angle is outside its joint's limits");
    }
    valid_ = true;
    return true;
  }

  // Starts pulses at the home pose. Servos jump there at power-up: keep hands clear.
  bool begin(uint32_t now) {
    if (!valid_ && !validate()) return false;
    for (uint8_t i = 0; i < kJointCount; ++i) pos_[i] = target_[i] = kJoints[i].homeDeg;
    attachAll();
    state_ = State::Holding;
    last_ = now;
    return true;
  }

  bool setJoint(uint8_t joint, int deg, uint16_t degPerSec) {
    if (joint >= kJointCount) return fail("no servo with that number");
    if (!inLimits(joint, deg)) return fail("angle is outside that servo's limits");
    if (!ready()) return false;
    target_[joint] = static_cast<float>(deg);
    speed_ = degPerSec;
    state_ = State::Moving;
    return true;
  }

  bool home() {
    if (!ready()) return false;
    for (uint8_t i = 0; i < kJointCount; ++i) target_[i] = kJoints[i].homeDeg;
    speed_ = kDefaultDegPerSec;
    state_ = State::Moving;
    return true;
  }

  bool squeeze() { return run(kSqueezeSteps, stepCount(kSqueezeSteps), "squeeze"); }
  bool release() { return run(kReleaseSteps, stepCount(kReleaseSteps), "release"); }

  // Freeze where the sticks are now and abandon any sequence. Keeps holding torque.
  void stop() {
    for (uint8_t i = 0; i < kJointCount; ++i) target_[i] = pos_[i];
    steps_ = nullptr;
    if (state_ != State::Relaxed) state_ = State::Holding;
  }

  // Stop pulses so the servos go limp and quiet. The next move restarts from the
  // last commanded angles, so a stick pushed by hand meanwhile will snap back.
  void relax() {
    stop();
    for (uint8_t i = 0; i < kJointCount; ++i) out_.detach(i);
    state_ = State::Relaxed;
  }

  void update(uint32_t now) {
    uint32_t dt = now - last_;
    last_ = now;
    if (dt > kMaxTickMs) dt = kMaxTickMs;
    if (state_ != State::Moving && state_ != State::Sequence) return;
    if (!slew(dt)) return;
    if (state_ == State::Moving) {
      state_ = State::Holding;
      return;
    }
    if (!arrived_) {
      arrived_ = true;
      arrivedAt_ = now;
    }
    if (now - arrivedAt_ < steps_[index_].holdMs) return;
    if (++index_ >= count_) {
      steps_ = nullptr;
      state_ = State::Holding;
      return;
    }
    loadStep();
  }

  State state() const { return state_; }
  int angle(uint8_t joint) const { return static_cast<int>(pos_[joint] + 0.5f); }
  int targetAngle(uint8_t joint) const { return static_cast<int>(target_[joint] + 0.5f); }
  const char* sequenceName() const { return steps_ ? sequence_ : ""; }
  const char* stepLabel() const { return steps_ ? steps_[index_].label : ""; }
  uint8_t stepIndex() const { return steps_ ? index_ : 0; }
  const char* error() const { return error_; }

 private:
  bool fail(const char* message) {
    error_ = message;
    return false;
  }

  static bool stepsValid(const Step* steps, uint8_t count) {
    for (uint8_t s = 0; s < count; ++s) {
      for (uint8_t i = 0; i < kJointCount; ++i) {
        const int deg = steps[s].deg[i];
        if (deg != kKeep && !inLimits(i, deg)) return false;
      }
    }
    return true;
  }

  // New commands wait for a running sequence to be stopped; a relaxed arm re-arms.
  bool ready() {
    if (!valid_) return fail("config invalid; fix ScooperConfig.h");
    if (state_ == State::Sequence) return fail("busy with a sequence; send stop first");
    if (state_ == State::Relaxed) attachAll();
    return true;
  }

  bool run(const Step* steps, uint8_t count, const char* name) {
    if (count == 0) return fail("sequence is empty");
    if (!ready()) return false;
    steps_ = steps;
    count_ = count;
    index_ = 0;
    sequence_ = name;
    state_ = State::Sequence;
    loadStep();
    return true;
  }

  void loadStep() {
    const Step& step = steps_[index_];
    for (uint8_t i = 0; i < kJointCount; ++i) {
      if (step.deg[i] != kKeep) target_[i] = step.deg[i];
    }
    speed_ = step.degPerSec;
    arrived_ = false;
  }

  // Moves each joint at most speed * dt toward its target. True once all arrived.
  bool slew(uint32_t dt) {
    const float maxStep = speed_ == 0 ? 180.0f : speed_ * (dt / 1000.0f);
    bool done = true;
    for (uint8_t i = 0; i < kJointCount; ++i) {
      const float diff = target_[i] - pos_[i];
      if (diff == 0) continue;
      if (diff > maxStep) pos_[i] += maxStep;
      else if (diff < -maxStep) pos_[i] -= maxStep;
      else pos_[i] = target_[i];
      out_.write(i, servoDeg(i));
      if (pos_[i] != target_[i]) done = false;
    }
    return done;
  }

  void attachAll() {
    for (uint8_t i = 0; i < kJointCount; ++i) {
      out_.attach(i);
      out_.write(i, servoDeg(i));
    }
  }

  // Logical angle -> servo angle: mirror if inverted, then add the horn trim.
  // The output layer clamps the result to the servo's 0-180 range.
  float servoDeg(uint8_t joint) const {
    const float deg = kJoints[joint].inverted ? 180.0f - pos_[joint] : pos_[joint];
    return deg + kJoints[joint].trimDeg;
  }

  Out& out_;
  State state_ = State::Relaxed;
  bool valid_ = false;
  float pos_[kJointCount] = {};
  float target_[kJointCount] = {};
  uint16_t speed_ = kDefaultDegPerSec;
  uint32_t last_ = 0;
  const Step* steps_ = nullptr;
  uint8_t count_ = 0, index_ = 0;
  const char* sequence_ = "";
  bool arrived_ = false;
  uint32_t arrivedAt_ = 0;
  const char* error_ = "";
};

}  // namespace scooper


// ===== esp32-companion/ServoPwm.h =====

#include <cmath>

namespace companion {
enum class PwmFault : uint8_t { None, Attach, Write, Detach, Argument };
inline const char* pwmFaultName(PwmFault fault) {
  switch (fault) {
    case PwmFault::Attach: return "attach";
    case PwmFault::Write: return "write";
    case PwmFault::Detach: return "detach";
    case PwmFault::Argument: return "invalid argument";
    default: return "none";
  }
}

// Actual HAL return values establish readiness, not an immediate duty/frequency
// readback. LEDC applies a new duty at the next PWM cycle (20 ms at 50 Hz).
// Used by the uploadable sketch and regression checks with delayed-readback HAL.
template<class Hal> class ServoPwm {
 public:
  static constexpr uint8_t kBits = 14;
  explicit ServoPwm(Hal& hal) : hal_(hal) {}
  void attach(uint8_t joint) {
    if (!valid(joint) || !healthy() || on_[joint]) return;
    if (!hal_.attach(scooper::kJoints[joint].pin, scooper::kServoHz, kBits)) { fail(PwmFault::Attach, joint); return; }
    on_[joint] = true; written_[joint] = false;
  }
  void write(uint8_t joint, float degrees) {
    if (!valid(joint) || !healthy()) return;
    if (!on_[joint] || !std::isfinite(degrees)) { fail(PwmFault::Argument, joint); return; }
    if (degrees < 0) degrees = 0;
    if (degrees > 180) degrees = 180;
    const float us = scooper::kPulseMinUs + (scooper::kPulseMaxUs - scooper::kPulseMinUs) * degrees / 180.0f;
    const uint32_t duty = static_cast<uint32_t>(us * (1UL << kBits) * scooper::kServoHz / 1000000.0f + 0.5f);
    if (!hal_.write(scooper::kJoints[joint].pin, duty)) { fail(PwmFault::Write, joint); return; }
    written_[joint] = true;
  }
  void detach(uint8_t joint) {
    if (!valid(joint) || !on_[joint]) return;
    if (!hal_.detach(scooper::kJoints[joint].pin)) { fail(PwmFault::Detach, joint); return; }
    on_[joint] = written_[joint] = false;
    hal_.low(scooper::kJoints[joint].pin);
  }
  bool healthy() const { return fault_ == PwmFault::None; }
  bool initialized() const {
    if (!healthy()) return false;
    for (uint8_t i = 0; i < scooper::kJointCount; ++i) if (!on_[i] || !written_[i]) return false;
    return true;
  }
  PwmFault fault() const { return fault_; }
  uint8_t faultJoint() const { return faultJoint_; }
 private:
  bool valid(uint8_t joint) { if (joint < scooper::kJointCount) return true; fail(PwmFault::Argument, joint); return false; }
  void fail(PwmFault fault, uint8_t joint) {
    if (healthy()) { fault_ = fault; faultJoint_ = joint; hal_.error(pwmFaultName(fault), joint); }
    // Roll back both outputs on an actual HAL error. Reconnect never rearms a
    // failed PWM output; recovery requires reset and fresh initialization.
    for (uint8_t i = 0; i < scooper::kJointCount; ++i) {
      if (!on_[i]) continue;
      hal_.detach(scooper::kJoints[i].pin); hal_.low(scooper::kJoints[i].pin);
      on_[i] = written_[i] = false;
    }
  }
  Hal& hal_;
  PwmFault fault_ = PwmFault::None;
  uint8_t faultJoint_ = 255;
  bool on_[scooper::kJointCount] = {}, written_[scooper::kJointCount] = {};
};
}  // namespace companion


// ===== esp32-companion/ArduinoServoPwm.h =====

#include <Arduino.h>

namespace companion {
class ArduinoServoPwm {
 public:
  bool attach(uint8_t pin, uint32_t hz, uint8_t bits) { return ledcAttach(pin, hz, bits); }
  bool write(uint8_t pin, uint32_t duty) { return ledcWrite(pin, duty); }
  bool detach(uint8_t pin) { return ledcDetach(pin); }
  void low(uint8_t pin) { pinMode(pin, OUTPUT); digitalWrite(pin, LOW); }
  void error(const char* stage, uint8_t joint) {
    if (joint < scooper::kJointCount) Serial.printf("Servo PWM %s failed: %s GPIO%u. Both outputs disabled.\n", stage, scooper::kJoints[joint].name, scooper::kJoints[joint].pin);
    else Serial.printf("Servo PWM %s failed: invalid joint %u. Both outputs disabled.\n", stage, joint);
  }
};
